# ──────────────────────────────────────────────────────
# LaundryPro backend — copy to .env and fill in values
# ──────────────────────────────────────────────────────

# Database
POSTGRES_PASSWORD=changeme

# Auth & encryption (REQUIRED — app refuses to start without these)
JWT_SECRET=changeme-min-32-chars
ENCRYPTION_KEY=changeme-min-32-chars
ADMIN_PASSWORD=changeme-min-8-chars

# Optional overrides
ADMIN_EMAIL=admin@laundrypro.local
ADMIN_NAME=System Administrator
CORS_ORIGINS=
APP_DOMAIN=localhost
ACME_EMAIL=admin@example.com
