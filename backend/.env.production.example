# ==============================================================
# LaundryPro PRODUCTION environment template
# Copy to .env (or your secrets manager) and set REAL values.
# ENV=production fails fast if any secret below is weak or default.
# ==============================================================

# ---- Server ----
PORT=8080
ENV=production
LOG_LEVEL=info
LOG_FORMAT=json
SHUTDOWN_TIMEOUT=15s

# Comma-separated browser origins allowed to call the API (e.g. https://app.example.com).
# Leave empty to deny all browser origins in production.
CORS_ORIGINS=https://app.example.com

# ---- Database ----
DATABASE_URL=postgres://aeroxe:CHANGE_ME@db-host:5432/laundry_pro?sslmode=require

# ---- Redis ----
REDIS_URL=redis://:CHANGE_ME@redis-host:6379/0
REDIS_PREFIX=laundry-pro

# ---- NATS (optional; the app degrades to a no-op publisher) ----
NATS_URL=nats://nats-host:4222
NATS_ENABLED=false

# ---- Security (REQUIRED: unique, >=32 chars, from a secrets manager) ----
JWT_SECRET=REPLACE_WITH_32+_RANDOM_CHARS
ENCRYPTION_KEY=REPLACE_WITH_32+_RANDOM_CHARS
PASSWORD_COST=12

# ---- Bootstrap admin (created on first boot only) ----
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_NAME=System Administrator

# ---- Outbox relay ----
OUTBOX_POLL_INTERVAL=2s
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5

# ---- Rate limit (per identity per minute; sensitive routes derive stricter caps) ----
RATE_LIMIT_PER_MIN=120

# ---- Request body limit (bytes) ----
MAX_BODY_BYTES=5242880

# ---- TLS reverse proxy (Caddy, see docker-compose.yml) ----
# A real domain enables automatic Let's Encrypt certificates.
APP_DOMAIN=api.yourdomain.com
ACME_EMAIL=ops@yourdomain.com
